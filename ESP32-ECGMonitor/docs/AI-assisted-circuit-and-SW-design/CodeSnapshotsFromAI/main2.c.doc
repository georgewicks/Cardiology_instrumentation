#include <stdio.h>
#include "freertos/FreeRTOS.h"
#include "freertos/task.h"
#include "freertos/queue.h"
#include "freertos/semphr.h"
#include "driver/i2c.h"
#include "driver/gpio.h"
#include "esp_vfs_fat.h"
#include "sdmmc_cmd.h"

#define I2C_MASTER_SDA_IO           4
#define I2C_MASTER_SCL_IO           5
#define I2C_MASTER_NUM              I2C_NUM_0
#define I2C_MASTER_FREQ_HZ          400000

#define ADS1115_I2C_ADDR            0x48
#define ADS1115_CONV_REG            0x00
#define ADS1115_CFG_REG             0x01

#define ADS_ALERT_GPIO              6
#define ESP_INTR_FLAG_DEFAULT       0

// Data structures for cross-core buffering
typedef struct {
    uint32_t timestamp;
    int16_t channels[4];
} adc_sample_t;

static QueueHandle_t adc_queue = NULL;
static SemaphoreHandle_t ads_rdy_semaphore = NULL;

// Channel MUX array configuration for 860 SPS, Continuous Mode, FSR = +/-2.048V
// Traditional continuous configuration but with ALERT/RDY pin assertion enabled
static const uint16_t ads_mux_config[4] = {
    0x44E8, // Channel 0 to GND, 860 SPS, Continuous, Alert Active Low
    0x54E8, // Channel 1 to GND, 860 SPS, Continuous, Alert Active Low
    0x64E8, // Channel 2 to GND, 860 SPS, Continuous, Alert Active Low
    0x74E8  // Channel 3 to GND, 860 SPS, Continuous, Alert Active Low
};

// Hardware Interrupt Service Routine
static void IRAM_ATTR ads_gpio_isr_handler(void* arg) {
    BaseType_t xHigherPriorityTaskWoken = pdFALSE;
    xSemaphoreGiveFromISR(ads_rdy_semaphore, &xHigherPriorityTaskWoken);
    if (xHigherPriorityTaskWoken) {
        portYIELD_FROM_ISR();
    }
}

// Inline I2C helper write functions
static esp_err_t ads1115_write_reg(uint8_t reg, uint16_t val) {
    uint8_t out_buf[3] = { reg, (uint8_t)(val >> 8), (uint8_t)(val & 0xFF) };
return i2c_master_write_to_device(I2C_MASTER_NUM, ADS1115_I2C_ADDR, out_buf, 
               3, pdMS_TO_TICKS(10));
}

static esp_err_t ads1115_read_reg(uint8_t reg, uint16_t *val) {
    uint8_t in_buf[2];
esp_err_t err = i2c_master_write_read_device(I2C_MASTER_NUM, ADS1115_I2C_ADDR, 
                        &reg, 1, in_buf, 2, pdMS_TO_TICKS(10));
    if (err == ESP_OK) {
        *val = (in_buf[0] << 8) | in_buf[1];
    }
    return err;
}

// High Priority Core 0 Data Acquisition Thread
void adc_acquisition_task(void *pvParameters) {
    uint8_t current_channel = 0;
    adc_sample_t current_batch = {0};
    uint16_t raw_reading = 0;

    // Step 1: Force active continuous sequence conversion on first channel
    ads1115_write_reg(ADS1115_CFG_REG, ads_mux_config[current_channel]);

    while (1) {
        // Wait for ALERT pin to flag active reading completion
        if (xSemaphoreTake(ads_rdy_semaphore, portMAX_DELAY) == pdTRUE) {
            // Read valid data output register
            if (ads1115_read_reg(ADS1115_CONV_REG, &raw_reading) == ESP_OK) {
                current_batch.channels[current_channel] = (int16_t)raw_reading;
            }

            // Immediately switch multiplexer configuration target to prepare the next conversion line
            uint8_t next_channel = (current_channel + 1) % 4;
            ads1115_write_reg(ADS1115_CFG_REG, ads_mux_config[next_channel]);

            // If a complete 4-channel sweeping loop finished, push structured metrics into queue buffer
            if (current_channel == 3) {
                current_batch.timestamp = xTaskGetTickCount() * portTICK_PERIOD_MS;
                xQueueSend(adc_queue, &current_batch, 0);
            }
            current_channel = next_channel;
        }
    }
}

// Standard Core 1 Low Priority SD Card Writer Thread
void sd_writer_task(void *pvParameters) {
    adc_sample_t log_data;
    while (1) {
        if (xQueueReceive(adc_queue, &log_data, portMAX_DELAY) == pdTRUE) {
            FILE* f = fopen("/sdcard/adc_log.csv", "a");
            if (f != NULL) {
                fprintf(f, "%lu,%d,%d,%d,%d\n", 
                        log_data.timestamp, 
                        log_data.channels[0], 
                        log_data.channels[1], 
                        log_data.channels[2], 
                        log_data.channels[3]);
                fclose(f);
            }
        }
    }
}

void app_main(void) {
    // 1. Setup I2C Peripheral
    i2c_config_t conf = {
        .mode = I2C_MODE_MASTER,
        .sda_io_num = I2C_MASTER_SDA_IO,
        .sda_pullup_en = GPIO_PULLUP_ENABLE,
        .scl_io_num = I2C_MASTER_SCL_IO,
        .scl_pullup_en = GPIO_PULLUP_ENABLE,
        .master.clk_speed = I2C_MASTER_FREQ_HZ,
    };
    i2c_param_config(I2C_MASTER_NUM, &conf);
    i2c_driver_install(I2C_MASTER_NUM, conf.mode, 0, 0, 0);

    // 2. Setup ALERT GPIO Interrupt Service Structure
    gpio_config_t io_conf = {
        .intr_type = GPIO_INTR_NEGEDGE, // Alert pin assertions force low pull drops
        .pin_bit_mask = (1ULL << ADS_ALERT_GPIO),
        .mode = GPIO_MODE_INPUT,
        .pull_up_en = GPIO_PULLUP_ENABLE // Internal backup safeguard pull-up
    };
    gpio_config(&io_conf);
    
    ads_rdy_semaphore = xSemaphoreCreateBinary();
    adc_queue = xQueueCreate(50, sizeof(adc_sample_t));

    gpio_install_isr_service(ESP_INTR_FLAG_DEFAULT);
    gpio_isr_handler_add(ADS_ALERT_GPIO, ads_gpio_isr_handler, NULL);

    // [SDMMC Initializations omitted here for snippet clarity but mapping pins 39,40,41,42,1,2]

    // 3. Pin tasks to unique execution physical processor cores
    xTaskCreatePinnedToCore(adc_acquisition_task, "ADC_Acq", 4096, NULL, 10, NULL, 0);
    xTaskCreatePinnedToCore(sd_writer_task, "SD_Write", 4096, NULL, 4, NULL, 1);
}
